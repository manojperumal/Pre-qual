# Postgres connection string for the SHARED Pre-qual Supabase database
# (Supabase → Project Settings → Database → Connection string, "Session pooler" / port 5432).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Same Supabase project Pre-qual uses — staff sign in with their existing accounts.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>      # private media bucket for worker photos
# Optional fast path: legacy HS256 JWT secret (Project Settings → API → JWT secret).
SUPABASE_JWT_SECRET=

# Public URL of the orientation client (used in SMS links and QR codes) and allowed CORS origins.
ORIENTATION_APP_URL=https://orientation.safetymojo.example
ORIENTATION_CLIENT_ORIGINS=https://orientation.safetymojo.example

# Long random secret for worker sessions and signed media links. REQUIRED in production.
ORIENTATION_TOKEN_SECRET=

# Twilio for SMS one-time codes, crew invites and expiry reminders.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555550123
# or TWILIO_MESSAGING_SERVICE_SID=

PORT=3002
# ORIENTATION_MEDIA_BUCKET=orientation-media
# ORIENTATION_SCHEDULER_INTERVAL_MS=600000
# ORIENTATION_EXPOSE_DEV_OTP=false   # never true in production
